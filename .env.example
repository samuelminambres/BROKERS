# Copia este archivo a .env y rellena tu clave.
GEMINI_API_KEY=

# Modelo de texto/validación CNMV.
GEMINI_MODEL=gemini-3.5-flash-lite

# Modelo de visión del oráculo.
GEMINI_VISION_MODEL=gemini-3.5-flash

# Los titulares usan el banco local por defecto para ahorrar cuota.
# Pon 1 solo si quieres generarlos con IA.
GEMINI_TITULARES=0
